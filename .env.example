# Keep this file private (chmod 600): control refuses to read the password from
# an .env that other users can read, and never exports it to os.environ.
CONTROL_SUDO_PASSWORD="00000"

# Reject insecure .env files entirely instead of warning.
# CONTROL_ENV_STRICT=1

# Print JSON (including structured errors) for every command.
# CONTROL_JSON=1

# --- multi-agent (all optional) ---
# Act as this agent session: scopes window commands to its virtual desktop and
# uses its own browser profile. See "Running several agents in parallel" in README.
# CONTROL_SESSION_ID=agent_1

# Seconds to wait for another agent to finish sending input before giving up.
# CONTROL_INPUT_LOCK_TIMEOUT=30# JSON file with extra/overriding selectors for `control browser ask` (see README).
# CONTROL_AI_SITES=/path/to/ai-sites.json
